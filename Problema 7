#include <iostream>
#include <string>

int main() {
    std::string palabra = "palabras";
    size_t n = palabra.length();
    
    for (size_t i = 0; i < n - 1; ++i) {
        for (size_t j = i + 1; j < n; ++j) {
            if (palabra.at(i) > palabra.at(j)) {
                char aux = palabra.at(i);
                palabra.at(i) = palabra.at(j);
                palabra.at(j) = aux;
            }
        }
    }
    
    std::cout << "Salida esperada: " << palabra << std::endl;
    return 0;
}
