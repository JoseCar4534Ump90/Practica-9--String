#include <iostream>
#include <string>
#include <cctype>

int main() {
    std::string texto = "jornadas de ciencias de la computacion";
    
    for (int i = texto.size() - 1; i >= 0; --i) {
        char c = tolower(texto.at(i));
        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {
            texto.erase(i, 1);
        }
    }
    
    std::cout << "Salida esperada: " << texto << std::endl;
    return 0;
}
